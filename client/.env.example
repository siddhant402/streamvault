# Copy to .env.local if you need to change these.
#
# By default the web app forwards /api/* to the server at http://127.0.0.1:8080, so the browser
# only talks to the web app's own address. Change where the server is with:
# SV_BACKEND_URL=http://127.0.0.1:8080
#
# Only to make the browser call a server on another address directly (needs SV_CORS_ORIGINS on the server):
# NEXT_PUBLIC_API_URL=http://192.168.1.20:8080
